[flake8]
max-line-length = 120
max-complexity = 10
extend-ignore =
    COM812,
    ISC003,
    E203,
    W503,
    ANN101,
    ANN102,
    U101,
    TC003
extend-select =
    A,
    ANN,
    B, B9,
    C4,
    C90,
    COM,
    DTZ,
    E,
    EM,
    ERA,
    FBT,
    LOG,
    ISC,
    N,
    PERF,
    PIE,
    PT,
    Q,
    RET,
    RSE,
    S,
    SIM,
    T10,
    T20,
    TCH,
    TRY,
    W,
    YTT,

inline-quotes = double
multiline-quotes = double
docstring-quotes = double

per-file-ignores =
    src/saferaise/_version.py: ALL
    tests/*: S101,S102,D100,D101,D102,D103,ANN,TRY003,EM101,ERA001,N801,FBT,SIM117,TC001,TC003

exclude =
    src/saferaise/_version.py,
    .venv,
    build,
    dist,
    __pycache__,
    *.egg-info